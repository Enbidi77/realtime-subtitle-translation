# EchoLingo Environment Variables Template
# Copy to .env for local overrides. Never commit actual API keys.

# Cloud Speech Recognition (Optional)
OPENAI_API_KEY=
GROQ_API_KEY=

# Cloud Translation (Optional)
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

# Local LLM Translation (Optional, e.g. Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Application Settings
NODE_ENV=development
ECHOLINGO_DEBUG=false
