{
  "name": "@echo-lingo/dotnet-bridge",
  "version": "1.0.0",
  "description": "Cross-process IPC bridge between Electron and .NET self-contained binaries",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*.js": "./src/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@echo-lingo/contracts": "workspace:*",
    "@echo-lingo/logger": "workspace:*",
    "@echo-lingo/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}

