{
  "name": "echo-lingo",
  "productName": "EchoLingo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "description": "Real-Time Subtitle & Translation Desktop App",
  "author": "EchoLingo Team",
  "scripts": {
    "postinstall": "node scripts/rebrand-electron.cjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "turbo run typecheck",
    "clean:lock": "node scripts/clean-lock.cjs",
    "build:dotnet": "node scripts/build-dotnet.cjs",
    "package": "turbo run package",
    "package:msi": "turbo run package:msi",
    "build:msi:version": "node scripts/build-version.cjs",
    "package:appx": "turbo run package:appx",
    "package:msix": "turbo run package:msix",
    "build:msix:version": "node scripts/build-msix.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "turbo": "^2.11.10",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "winston": "^3.19.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
