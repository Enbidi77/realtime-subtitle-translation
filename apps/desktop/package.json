{
  "name": "@echo-lingo/desktop",
  "productName": "EchoLingo",
  "version": "1.0.2",
  "description": "EchoLingo",
  "author": "EchoLingo Team",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node ../../scripts/build-dotnet.cjs && node ../../scripts/rebrand-electron.cjs",
    "prebuild": "node ../../scripts/build-dotnet.cjs",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "package": "electron-vite build && electron-builder",
    "package:win": "electron-vite build && electron-builder --win",
    "package:msi": "electron-vite build && electron-builder --win msi",
    "package:dir": "electron-vite build && electron-builder --dir",
    "package:appx": "electron-vite build && electron-builder --win appx",
    "package:msix": "electron-vite build && electron-builder --win appx"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "sql.js": "^1.12.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@echo-lingo/config": "workspace:*",
    "@echo-lingo/contracts": "workspace:*",
    "@echo-lingo/database": "workspace:*",
    "@echo-lingo/dotnet-bridge": "workspace:*",
    "@echo-lingo/logger": "workspace:*",
    "@echo-lingo/ocr-core": "workspace:*",
    "@echo-lingo/provider-adapters": "workspace:*",
    "@echo-lingo/speech-core": "workspace:*",
    "@echo-lingo/subtitle-core": "workspace:*",
    "@echo-lingo/translation-core": "workspace:*",
    "@echo-lingo/shared": "workspace:*",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  }
}
