{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "package": {
      "dependsOn": ["build"],
      "outputs": ["release/**"],
      "cache": false
    },
    "package:win": {
      "dependsOn": ["build"],
      "outputs": ["release/**"],
      "cache": false
    },
    "package:msi": {
      "dependsOn": ["build"],
      "outputs": ["release/**"],
      "cache": false
    },
    "package:appx": {
      "dependsOn": ["build"],
      "outputs": ["release/**"],
      "cache": false
    },
    "package:msix": {
      "dependsOn": ["build"],
      "outputs": ["release/**"],
      "cache": false
    },
    "//#test": {
      "inputs": ["packages/**", "apps/**", "vitest.config.ts"],
      "outputs": []
    }
  }
}

