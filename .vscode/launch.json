{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EchoLingo: Debug Main Process",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "windows": {
        "runtimeExecutable": "pnpm.cmd"
      },
      "runtimeArgs": [
        "--filter",
        "@echo-lingo/desktop",
        "dev",
        "--",
        "--inspect=5858",
        "--remoteDebuggingPort=9222",
        "--sourcemap"
      ],
      "env": {
        "REMOTE_DEBUGGING_PORT": "9222"
      },
      "port": 5858,
      "timeout": 30000,
      "sourceMaps": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "presentation": {
        "order": 2
      }
    },
    {
      "name": "EchoLingo: Attach to Renderer",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "timeout": 60000,
      "urlFilter": "http://localhost:*",
      "webRoot": "${workspaceFolder}/apps/desktop/src/renderer",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "/@fs/*": "/*",
        "${workspaceFolder}/*": "${workspaceFolder}/*",
        "/*": "${workspaceFolder}/apps/desktop/src/renderer/*"
      },
      "presentation": {
        "order": 3
      }
    },
    {
      "name": "EchoLingo: Attach to Main",
      "type": "node",
      "request": "attach",
      "port": 5858,
      "timeout": 30000,
      "sourceMaps": true,
      "restart": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "presentation": {
        "order": 4
      }
    },
    {
      "name": "Vitest: Debug Current Test File",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}"],
      "console": "integratedTerminal",
      "presentation": {
        "order": 5
      }
    },
    {
      "name": "Vitest: Debug All Tests",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run"],
      "console": "integratedTerminal",
      "presentation": {
        "order": 6
      }
    },
    {
      "name": ".NET: EchoLingo.Ipc (Console Popup)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "EchoLingo.Ipc: Build",
      "program": "${workspaceFolder}/ipc/bin/Debug/net8.0-windows10.0.19041.0/win-x64/EchoLingo.Ipc.dll",
      "args": ["--daemon"],
      "cwd": "${workspaceFolder}/ipc",
      "stopAtEntry": false,
      "console": "externalTerminal",
      "presentation": {
        "group": ".NET",
        "order": 7
      }
    },
    {
      "name": ".NET: EchoLingo.Ipc (Daemon Mode)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "EchoLingo.Ipc: Build",
      "program": "${workspaceFolder}/ipc/bin/Debug/net8.0-windows10.0.19041.0/win-x64/EchoLingo.Ipc.dll",
      "args": ["--daemon"],
      "cwd": "${workspaceFolder}/ipc",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "internalConsoleOptions": "openOnSessionStart",
      "presentation": {
        "group": ".NET",
        "order": 8
      }
    },
    {
      "name": ".NET: EchoLingo.Ipc (CLI Args)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "EchoLingo.Ipc: Build",
      "program": "${workspaceFolder}/ipc/bin/Debug/net8.0-windows10.0.19041.0/win-x64/EchoLingo.Ipc.dll",
      "args": ["${input:dotnetCliArgs}"],
      "cwd": "${workspaceFolder}/ipc",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "internalConsoleOptions": "openOnSessionStart",
      "presentation": {
        "group": ".NET",
        "order": 9
      }
    },
    {
      "name": ".NET: Attach to EchoLingo.Ipc",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "presentation": {
        "group": ".NET",
        "order": 10
      }
    }
  ],
  "inputs": [
    {
      "id": "dotnetCliArgs",
      "type": "promptString",
      "description": "Enter CLI arguments for EchoLingo.Ipc (e.g. 'ping', 'speech list', 'ocr languages')",
      "default": "ping"
    }
  ],
  "compounds": [
    {
      "name": "EchoLingo: Full Debug (Main + Renderer)",
      "configurations": ["EchoLingo: Debug Main Process", "EchoLingo: Attach to Renderer"],
      "stopAll": true,
      "presentation": {
        "order": 1
      }
    }
  ]
}
